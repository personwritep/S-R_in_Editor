                node_disp=childs2[k].textContent; }
            else{
                node_disp=childs2[k].outerHTML; }

            alert(childs2[k].nodeName +'\n'+ node_disp); }
*/


        let mark=iframe_body.querySelectorAll('m');
        alert(mark.length);

        let native_line=iframe_html.scrollTop; // 通常表示のスクロール位置を記録
        let k=0;
        let flag=1;
        view(0);
        while(k<mark.length){
            k=next(k); }

        function next(k){

            iframe_doc.addEventListener("keydown", check_key);
            function check_key(event){

                if(flag==1){
                    if(event.shiftKey==true && event.keyCode==13){
                        event.preventDefault();
                        if(k>0){
                            k=k-1; }
                        view(k);
                        return k; }
                    if(event.shiftKey==true){
                        event.preventDefault();
                        return k; }
                    if(event.keyCode==13){
                        event.preventDefault();
                        if(k<mark.length -1){
                            k+=1; }
                        view(k);
                        return k; }
                    else{
                        event.preventDefault();
                        iframe_html.scrollTop=native_line;
                        flag=0; }}}}

        function view(k){
            mark[k].scrollIntoView();
            i_body.scrollIntoView(); }


        iframe_doc.addEventListener("click", stop_out);
        function stop_out(){
            if(flag==1){
                native_line=iframe_html.scrollTop;
                flag=0; }}

    } // search_replace()
})
